// pinright.dev: the built site (dist/) served as static assets on Cloudflare Workers.
// No Worker code runs; _headers in dist/ sets the CSP and the other response headers.
//
//   npm run build && npx wrangler@4 deploy
{
  "name": "pinright-site",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [{ "pattern": "pinright.dev", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
