{
  "name": "safectx",
  "version": "0.1.0",
  "description": "MCP server that serves up-to-date library docs (via Context7) and tells the agent which version is free of known vulnerabilities (via deps.dev and OSV).",
  "license": "MIT",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "safectx": "dist/server.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "bench": "tsx bench/run.ts",
    "coverage:ecosystem": "tsx scripts/coverage.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "bench:agents": "tsx bench/agents/run.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "semver": "^7.7.1",
    "undici": "^6.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^20.17.0",
    "@types/semver": "^7.5.8",
    "eslint": "^9.20.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.0"
  }
}
