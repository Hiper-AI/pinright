{
  "name": "safectx",
  "version": "0.2.0",
  "description": "Version-accurate library docs for coding agents, with a supply-chain verdict: safe versions, whole-tree audit and a pre-install hook (deps.dev + OSV).",
  "license": "MIT",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "safectx": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "bench": "tsx bench/run.ts",
    "coverage:ecosystem": "tsx scripts/coverage.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "bench:agents": "tsx bench/agents/run.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "semver": "^7.7.1",
    "undici": "^6.21.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.20.5",
    "@types/semver": "^7.5.8",
    "eslint": "^9.20.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^5.0.5"
  }
}
